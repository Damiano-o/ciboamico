@startuml
' === Activity Diagram — UC-04 Ordina un Prodotto (MSS + estensione buono) ===
start
:Seleziona prodotto;
:Verifica disponibilità;
if (disponibile?) then (sì)
  :Calcola totale;
  if (codice buono?) then (sì)
    :Valida e applica buono\n(BuonoDAO -> ScontoStrategy);
  endif
  :Conferma ordine;
  ' fork concorrente: pagamento | notifica | timer
  fork
    :Autorizza\npagamento;
  fork again
    :Notifica venditore\n(Observer);
    :Attesa\napprovazione;
  fork again
    :Timer\n30 min;
  end fork
  ' MERGE tra Attesa e Timer (non Join): prosegue al primo dei due eventi
  if (timeout 30 min scaduto?) then (sì)
    :Annulla ordine\nper timeout;
    stop
  else (no)
    :Registra ordine;
    :Fine;
    stop
  endif
else (no)
  :Mostra errore\n(scorte residue);
  stop
endif
@enduml
