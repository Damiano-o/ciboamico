@startuml
allowmixing
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 30
skinparam classFontSize 13
skinparam classAttributeFontSize 12
left to right direction

' ============================================================
' VOPC (analysis BCE) — UC-04 Ordina un Prodotto
' Modello pre-MVC: SOLO Boundary / Control / Entity.
' Attributi rilevanti di dominio + operazioni di business; niente
' getter/setter, DTO/Bean o DAO (reverse engineering) in questa vista.
' ============================================================

' ---------- BOUNDARY ----------
class "MarketplaceView" <<boundary>> #A9D6FF {
  - prodottoSelezionato : String
  - totaleCorrente : double
  + mostraCatalogo(prodotti) : void
  + selezioneProdotto(nome) : void
  + applicaBuono(codice) : void
  + ordina() : void
}

class "PaymentView" <<boundary>> #A9D6FF {
  - datiCarta : String
  + inserisciDatiCarta() : void
  + confermaPagamento() : void
  + mostraEsito(esito) : void
}

class "PaymentGateway" <<boundary>> #D8C7F0 {
  + autorizza(importo) : boolean
}

class "VenditoreNotifier" <<boundary>> #D8C7F0 {
  + notificaOrdine(ordine) : void
}

' ---------- CONTROL ----------
class "OrdinaProdottoController" <<control>> #A9E8B0 {
  + inizializzaCatalogo() : List<Prodotto>
  + creaOrdineProdotto(prodotto) : void
  + applicaBuonoPromozionale(codice) : boolean
  + autorizzaPagamento(importo) : boolean
  + registraOrdine(ordine) : void
  + notificaVenditore(ordine) : void
}

' ---------- ENTITY ----------
class "Ordine" <<entity>> #FCD9A9 {
  - idOrdine : Long
  - stato : Stato
  - totale : double
  + aggiungiVoce(prodotto) : void
  + applicaBuono(buono) : void
  + ricalcolaTotale() : void
  + cambiaStato(nuovoStato) : void
}

class "Prodotto" <<entity>> #FCD9A9 {
  - nome : String
  - prezzo : double
  - quantitaDisponibile : int
  + riduciDisponibilita(quantita) : void
}

class "BuonoPromozionale" <<entity>> #FCD9A9 {
  - codice : String
  - valido : boolean
  + isValido() : boolean
  + applicaSconto(subtotale) : double
}

class "Utente" <<entity>> #FCD9A9 {
  - nome : String
  - email : String
  - vouchersUsati : List<String>
  + haUsatoBuono(codice) : boolean
  + registraBuonoUsato(codice) : void
}

' ============================================================
' ASSOCIAZIONI BCE
' ============================================================
' Attore -> boundary (a margine)
actor "Cliente" as cliente
actor "Venditore" as venditore
cliente --> MarketplaceView
cliente --> PaymentView
VenditoreNotifier --> venditore : notifica

' Boundary -> Control
MarketplaceView --> OrdinaProdottoController
PaymentView --> OrdinaProdottoController
OrdinaProdottoController --> PaymentGateway : autorizza

' Control -> Entity (1:1 relazioni di dominio)
OrdinaProdottoController --> Ordine : crea/gestisce
OrdinaProdottoController --> Prodotto : catalogo
OrdinaProdottoController --> BuonoPromozionale : valida
OrdinaProdottoController --> Utente : cliente
OrdinaProdottoController --> VenditoreNotifier : notifica

' Entity <=> Entity (leggibili)
Ordine --> Prodotto : contiene 1..*
Ordine --> BuonoPromozionale : applica 0..1
Ordine --> Utente : intestatario 1

@enduml