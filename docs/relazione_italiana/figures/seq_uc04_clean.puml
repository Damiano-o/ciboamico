@startuml
skinparam style strictuml
skinparam SequenceMessageAlignment left
skinparam ParticipantPadding 24
skinparam Shadowing false
skinparam MaxMessageSize 150

actor "Cliente" as cliente
participant "MarketplaceView" as mkView <<boundary>>
participant "PaymentView" as payView <<boundary>>
participant "OrdinaProdottoController" as controller <<control>>
participant "OrdineBean" as ordineBean <<bean>>
participant "UtenteBean" as utenteBean <<bean>>
participant "PaymentInfoBean" as paymentBean <<bean>>
participant "PaymentGateway" as gateway <<boundary>>
participant "BuonoDAO" as buonoDao <<boundary>>
participant "ProdottoDAO" as prodottoDao <<boundary>>
participant "OrdineDAO" as ordineDao <<boundary>>
participant "BuonoPromozionale" as buono <<entity>>
participant "Prodotto" as prodotto <<entity>>
participant "Ordine" as ordine <<entity>>
participant "VenditoreNotifier" as notifier <<boundary>>
actor "Venditore" as venditore

' ===== FASE 1 - Catena a gradino (inizializzazione BCE) =====
cliente -> mkView : 1: Login (cliente autenticato)
activate mkView
mkView -> controller : 2: <<create>>\nInitialize OrdinaProdottoController()
activate controller
controller --> mkView : 3: return
deactivate controller
deactivate mkView

' ===== FASE 2 - Catalogo =====
cliente -> mkView : 4: clickAggiornaCatalogo()
activate mkView
mkView -> controller : 5: getProdottiDisponibili()
activate controller
controller -> prodottoDao : 6: prodottoDAO.findAll()
activate prodottoDao
prodottoDao --> controller : 7: List<Prodotto>
deactivate prodottoDao
controller --> mkView : 8: List<ProdottoBean>
deactivate controller
deactivate mkView

' ===== FASE 3 - Selezione prodotto (crea OrdineBean) =====
cliente -> mkView : 9: selectProdotto(nome)
activate mkView
mkView -> ordineBean : 10: <<create>>\nInitialize OrdineBean()
deactivate mkView

' ===== ESTENSIONE 4a - applica buono (opzionale) =====
opt [inserisce codice buono]
    cliente -> mkView : 11: applicaBuono(codice)
    activate mkView
    mkView -> controller : 12: applicaBuonoPromozionale(codice, bean, utenteBean)
    activate controller
    controller -> buonoDao : 13: buonoDAO.findByCodice(codice)
    activate buonoDao
    buonoDao --> controller : 14: buono
    deactivate buonoDao
    controller -> buono : 15: buono.isValido()
    activate buono
    controller -> ordineBean : 16: ordineBean.setTotale(totaleScontato)
    activate ordineBean
    deactivate ordineBean
    controller --> mkView : 17: return OrdineBean (totale scontato)
    deactivate buono
    deactivate controller
    deactivate mkView
end

' ===== FASE 4 - Navigazione a PaymentView =====
cliente -> mkView : 18: clickOrdina() [nome != null]
activate mkView
mkView -> payView : 19: <<create>>\nInitialize PaymentView(ordineBean)
activate payView
deactivate mkView
cliente -> payView : 20: inserisciDatiCarta()

' ===== FASE 5 - processaPagamento (passo 6 / est. 6a) =====
payView -> paymentBean : 21: <<create>>\nInitialize PaymentInfoBean(datiCarta)
activate paymentBean
payView -> controller : 22: processaPagamento(bean, utenteBean, paymentInfoBean)
activate controller
controller -> paymentBean : 23: paymentInfoBean.getImportoInCent()
controller -> gateway : 24: paymentGateway.autorizza(importo)
activate gateway

alt [pagamento autorizzato]
    controller -> prodottoDao : 25: prodottoDAO.findByNome(nome)
    activate prodottoDao
    prodottoDao --> controller : 26: prodotto
    deactivate prodottoDao
    controller -> prodotto : 27: prodotto.riduciDisponibilita(1)
    activate prodotto
    controller -> prodottoDao : 28: prodottoDAO.update(prodotto)
    controller -> ordine : 29: <<create>>\nInitialize Ordine(compratore, venditore)
    activate ordine
    controller -> ordine : 30: ordine.aggiungiVoce(voce)
    controller -> ordineDao : 31: ordineDAO.save(ordine)
    activate ordineDao
    deactivate ordineDao
    controller -> ordine : 32: ordine.notificaSottomissione()
    ordine -> notifier : 33: subject.notifyObservers(ordine)
    activate notifier
    notifier --> venditore : 34: onStatoCambiato(ordine)   (asincrona)
    deactivate notifier
    deactivate ordine
    deactivate prodotto
    deactivate gateway
    controller --> payView : 35: return OrdineBean (id, totale, stato)
    deactivate controller
    payView --> cliente : 36: mostraConferma("Ordine creato")
    deactivate payView
else [pagamento negato (6a)]
    controller --> payView : 37: <<exception>>\nBusinessValidationException
    deactivate controller
    deactivate gateway
    deactivate ordine
    deactivate prodotto
    payView --> cliente : 38: mostraErroreInline
    deactivate payView
end

deactivate paymentBean
@enduml