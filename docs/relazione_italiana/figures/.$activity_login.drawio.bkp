<mxfile host="Electron">
  <diagram id="act-login" name="Activity Login">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- START -->
        <mxCell id="start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Inserisci credenziali -->
        <mxCell id="cred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Inserisci email&#10;e password" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Valida email -->
        <mxCell id="valida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Valida email&#10;(sintassi)" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Decisione email valida -->
        <mxCell id="dEmail" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="email&#10;valida?" vertex="1" parent="1">
          <mxGeometry x="340" y="340" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Errore email -->
        <mxCell id="errEmail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="Errore:&#10;Email non valida" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Ricerca utente -->
        <mxCell id="find" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Ricerca utente&#10;(UtenteDAO.findByEmail)" vertex="1" parent="1">
          <mxGeometry x="230" y="500" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decisione credenziali -->
        <mxCell id="dCred" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="utente trovato&#10;e password&#10;corretta?" vertex="1" parent="1">
          <mxGeometry x="250" y="610" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Errore credenziali -->
        <mxCell id="errCred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="Errore:&#10;Credenziali non valide" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Imposta sessione -->
        <mxCell id="sess" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Imposta sessione&#10;(SessionManager.setLoggedUser)" vertex="1" parent="1">
          <mxGeometry x="250" y="770" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Home -->
        <mxCell id="home" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="Mostra home&#10;(famiglia di ruolo)" vertex="1" parent="1">
          <mxGeometry x="250" y="880" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- FINE -->
        <mxCell id="end" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="980" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ============ COLLEGAMENTI ============ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="start" target="cred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="cred" target="valida">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="valida" target="dEmail" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="valida" target="find" value="sì">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="dEmail" target="errEmail" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dEmail" target="valida" value="sì (riprova)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="find" target="dCred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="dCred" target="errCred" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dCred" target="sess" value="sì">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="errEmail" target="valida">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" edge="1" parent="1" source="errCred" target="cred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sess" target="home" value="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="home" target="end" value="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
