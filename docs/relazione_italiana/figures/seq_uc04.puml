@startuml
skinparam style strictuml
skinparam SequenceMessageAlignment center
skinparam ParticipantPadding 28
skinparam Shadowing false

actor "Cliente" as cliente
participant "MarketplaceView" as boundary <<boundary>>
participant "PaymentView" as payView <<boundary>>
participant "OrdinaProdottoController" as controller <<control>>
participant "OrdineBean" as bean <<bean>>
participant "PaymentInfoBean" as paymentBean <<bean>>
participant "PaymentGateway" as gateway <<external>>
participant "BuonoDAO" as buonoDao <<DAO>>
participant "BuonoPromozionale" as buono <<entity>>
participant "Prodotto" as prodotto <<entity>>
participant "ProdottoDAO" as prodottoDao <<DAO>>
participant "Ordine" as ordine <<entity>>
participant "OrdineDAO" as ordineDao <<DAO>>
participant "VenditoreNotifier" as notifier <<observer>>
actor "Venditore" as venditore

' === FASE 1 a gradino: inizializzazione BCE ===
cliente -> boundary : 1: Ordina un prodotto
activate boundary
boundary -> controller : 2: <<create>>\nInitialize OrdinaProdottoController()
activate controller
controller -> bean : 3: <<create>>\nInitialize OrdineBean()
activate bean
controller <-- bean
deactivate bean

' === FASE 2a: ESTENSIONE 4a — applica buono (opzionale) ===
opt [inserisce codice buono]
    cliente -> boundary : 4: clickApplicaBuono(codice)
    boundary -> controller : 5: applicaBuonoPromozionale(codice, bean, utente)
    controller -> buonoDao : 6: buonoDAO.findByCodice(codice)
    buonoDao --> controller : buono
    controller -> buono : 7: buono.isValido()
    controller -> ordine : 8: ordine.applicaBuono(buono)
    controller --> boundary : 9: return OrdineBean (totale scontato)
end

' === FASE 2b: PASSAGGIO A PAGAMENTO ===
cliente -> boundary : 10: clickOrdinaProdotto()
boundary -> controller : 11: setOrdineInCorso(prodotto)
boundary -> paymentView : 12: naviga a PaymentView
cliente -> paymentView : 13: inserisce dati carta

' === FASE 2c: processaPagamento (paso 6 + 6a) ===
paymentView -> controller : 14: processaPagamento(bean, utente, paymentInfoBean)
controller -> paymentBean : 15: paymentInfoBean.getImportoInCent()
controller -> gateway : 16: paymentGateway.autorizza(importo)
alt [pagamento autorizzato]
    controller -> prodottoDao : 17: prodottoDAO.findByNome(nome)
    prodottoDao --> controller : prodotto
    controller -> prodotto : 18: prodotto.riduciDisponibilita(1)
    controller -> prodottoDao : 19: prodottoDAO.update(prodotto)

    controller -> ordine : 20: <<create>>\nInitialize Ordine()
    activate ordine
    controller -> ordine : 21: ordine.aggiungiVoce(voce)
    controller -> ordineDao : 22: ordineDAO.save(ordine)

    ' Notifica asincrona al venditore (Observer)
    controller -> ordine : 23: ordine.notificaSottomissione()
    controller -> notifier : 24: subject.notifyObservers(ordine)
    activate notifier
    notifier --> venditore : 25: onStatoCambiato(ordine)  (asincrona, no return)
    deactivate notifier

    controller --> paymentView : 26: return OrdineBean (id, totale, stato)
    deactivate ordine
    paymentView --> boundary : 27: resetForm() + torna a Marketplace
    boundary --> cliente : 28: Messaggio "Ordine creato"
else [pagamento negato (6a)]
    controller --> paymentView : 29: BusinessValidationException ("Pagamento negato")
    paymentView --> cliente : 30: mostra errore inline (resta su PaymentView)
end

deactivate controller
deactivate boundary
@enduml