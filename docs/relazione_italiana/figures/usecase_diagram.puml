@startuml
skinparam style strictuml
skinparam linetype ortho
'
' Linee dritte (ortogonali), non curve
' Attori PRIMARI a destra, attori SECONDARI (esterni) a sinistra
' Tutto in italiano

' ===== SISTEMI ESTERNI (secondari) — SINISTRA =====
actor "Payment Service" as payment
actor "OpenFoodFacts" as openfoodfacts

rectangle "Sistema CiboAmico" {
  usecase "Gestisci Dispensa" as UC1
  usecase "Trova Ricette\nCompatibili" as UC2
  usecase "Calcola Lista\ndella Spesa" as UC3
  usecase "Ordina un Prodotto\nPunti di estensione:\napplicazioneCoupon" as UC4
  usecase "Pubblica Prodotto" as UC5
  usecase "Gestisci Ordini\nRicevuti" as UC6
  usecase "Crea Ricetta" as UC7
  usecase "Approva Venditori\ne Ricette" as UC8
  usecase "Applica\nBuono Promozionale" as UC9
  usecase "Naviga\nCatalogo Piattaforma" as UC10
  usecase "Autenticati" as UC11
}

' ===== ATTORI PRIMARI — DESTRA =====
actor "Cliente" as client
actor "Venditore" as vendor
actor "Nutrizionista" as nutritionist
actor "Amministratore" as administrator

' ===== ASSOCIAZIONI ATTORI PRIMARI (a destra) =====
UC1 --> client
UC2 --> client
UC3 --> client
UC4 --> client
UC10 --> client
UC5 --> vendor
UC6 --> vendor
UC7 --> nutritionist
UC8 --> administrator

' ===== INCLUDE (base -> incluso) =====
UC1 ..> UC11 : <<include>>
UC4 ..> UC11 : <<include>>
UC5 ..> UC11 : <<include>>
UC6 ..> UC11 : <<include>>

' ===== EXTEND (estensione -> base) =====
UC9 ..> UC4 : <<extend>>

' ===== SISTEMI ESTERNI (a sinistra, il sistema li chiama) =====
payment --> UC4
openfoodfacts --> UC2 : ricerca codice a barre
openfoodfacts --> UC7 : ricerca codice a barre

@enduml
