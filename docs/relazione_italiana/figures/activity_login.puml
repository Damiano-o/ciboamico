@startuml
' === Activity Diagram — Login (Autenticati) ===
start
:Inserisci email\ne password;
:Valida email\n(sintassi);
if (email valida?) then (sì)
  :Ricerca utente\n(UtenteDAO.findByEmail);
  if (utente trovato\ne password corretta?) then (sì)
    :Imposta sessione\n(SessionManager.setLoggedUser);
    :Mostra home\n(della famiglia di ruolo);
    stop
  else (no)
    :Mostra errore\n"Credenziali non valide";
    note right: riprova
  endif
else (no)
  :Mostra errore\n"Email non valida";
endif
:Fine;
@enduml
